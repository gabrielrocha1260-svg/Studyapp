# Copie para .env e preencha. O .env nunca vai para o git.

# --- obrigatórias ---
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# --- servidor ---
PORT=3000
# Origens que podem chamar a API (sem barra no fim; várias separadas por vírgula).
# Vazio = qualquer origem (só para uso local).
ALLOWED_ORIGINS=https://<domínio>
# Atrás de proxy (ngrok, Render): 1 = confiar em 1 salto, para o limite por IP valer por usuário.
# Deixe vazio se o servidor recebe conexões diretas.
TRUST_PROXY=1

# --- limites por IP, por minuto (0 desliga) ---
RATE_LIMIT_AI_PER_MIN=60
RATE_LIMIT_VIDEOS_PER_MIN=120

# Rotas /api/gemini-debug e /api/gemini-list fora do localhost. Mantenha false.
ENABLE_DEBUG_ENDPOINTS=false

# --- Caminho A (ngrok): domínio estático gratuito, sem https:// ---
NGROK_DOMAIN=

# --- opcionais (padrões no server.js) ---
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# GEMINI_WARMUP=true
# CACHE_PERSIST=true
# AI_TOTAL_BUDGET_MS=38000
# MAX_CONCURRENT_GEMINI=2
# MAX_QUEUE=40
